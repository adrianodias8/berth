+/* berth: how long a foreground request spins for its reply. */
+static unsigned int poll_us = 200;
+module_param(poll_us, uint, 0644);
+MODULE_PARM_DESC(poll_us, "Microseconds to poll for a reply before waiting for the interrupt (0: never poll)");
+
+/* berth: how polling went, for tuning (read-only parameters). */
+static unsigned long poll_hits, poll_misses, poll_skipped, poll_hit_ns;
+module_param(poll_hits, ulong, 0444);
+module_param(poll_misses, ulong, 0444);
+module_param(poll_skipped, ulong, 0444);
+module_param(poll_hit_ns, ulong, 0444);
+
+/*
+ * berth: wait for @req's reply by polling the used ring, with the queue's
+ * interrupt off, ending whatever completes meanwhile. Gives up after
+ * poll_us or when the CPU is wanted, and in any case finishes with the
+ * normal completion work, which turns the interrupt back on and collects
+ * stragglers. Only for foreground requests, sent from a context that may
+ * spin and end requests: the caller holds a reference to @req.
+ */
+static void virtio_fs_poll_reply(struct virtio_fs_vq *fsvq, struct fuse_req *req)
+{
+	struct fuse_pqueue *fpq = &fsvq->fud->pq;
+	struct virtqueue *vq = fsvq->vq;
+	u64 start = ktime_get_ns();
+	u64 deadline = start + (u64)READ_ONCE(poll_us) * NSEC_PER_USEC;
+	struct fuse_req *done;
+	unsigned int len;
+	LIST_HEAD(reqs);
+
+	spin_lock(&fsvq->lock);
+	virtqueue_disable_cb(vq);
+	spin_unlock(&fsvq->lock);
+
+	while (!test_bit(FR_FINISHED, &req->flags) &&
+	       ktime_get_ns() < deadline && !need_resched()) {
+		spin_lock(&fsvq->lock);
+		while ((done = virtqueue_get_buf(vq, &len)) != NULL) {
+			/* berth: as virtio_fs_requests_done_work does. */
+			if (!virtio_fs_verify_response(done, len)) {
+				done->out.h.error = -EIO;
+				done->out.h.len = sizeof(struct fuse_out_header);
+			}
+			spin_lock(&fpq->lock);
+			list_move_tail(&done->list, &reqs);
+			spin_unlock(&fpq->lock);
+		}
+		spin_unlock(&fsvq->lock);
+		if (list_empty(&reqs))
+			cpu_relax();
+		else
+			virtio_fs_end_reqs(fsvq, &reqs);
+	}
+	if (test_bit(FR_FINISHED, &req->flags)) {
+		WRITE_ONCE(poll_hits, poll_hits + 1);
+		WRITE_ONCE(poll_hit_ns, poll_hit_ns + ktime_get_ns() - start);
+	} else {
+		WRITE_ONCE(poll_misses, poll_misses + 1);
+	}
+	virtio_fs_requests_done_work(&fsvq->done_work);
+}
